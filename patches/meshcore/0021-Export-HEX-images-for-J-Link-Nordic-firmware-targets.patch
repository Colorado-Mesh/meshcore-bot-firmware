From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cj-vana <cj@depth23.online>
Date: Mon, 12 Oct 2026 14:05:34 -0600
Subject: [PATCH 21/23] Export HEX images for J-Link Nordic firmware targets

---
 build.sh | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/build.sh b/build.sh
index 1d59aadb..b3548fe3 100755
--- a/build.sh
+++ b/build.sh
@@ -114,6 +114,17 @@ for section, options in data:
 "
 }
 
+# get the configured upload protocol for a given environment
+get_upload_protocol_for_env() {
+  printf '%s' "$PIO_CONFIG_JSON" | python3 -c '
+import json, sys
+for section, options in json.load(sys.stdin):
+    if section == "env:" + sys.argv[1]:
+        print(dict(options).get("upload_protocol", ""))
+        break
+' "$1"
+}
+
 # disable all debug logging flags if DISABLE_DEBUG=1 is set
 disable_debug_flags() {
   if [ "$DISABLE_DEBUG" == "1" ]; then
@@ -167,6 +178,9 @@ build_firmware() {
     python3 bin/uf2conv/uf2conv.py .pio/build/$1/firmware.hex -c -o .pio/build/$1/firmware.uf2 -f 0xADA52840
     cp .pio/build/$1/firmware.uf2 out/${FIRMWARE_FILENAME}.uf2 2>/dev/null || true
     cp .pio/build/$1/firmware.zip out/${FIRMWARE_FILENAME}.zip 2>/dev/null || true
+    if [ "$(get_upload_protocol_for_env "$1")" == "jlink" ]; then
+      cp .pio/build/$1/firmware.hex out/${FIRMWARE_FILENAME}.hex
+    fi
   fi
 
   # for stm32, copy .bin and .hex to out folder
